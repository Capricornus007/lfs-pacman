# MLFS 8.80 Procps-ng-4.0.7 —— §8.80
pkgname=procps-ng
pkgver=4.0.7
pkgrel=1
pkgdesc="行程與系統監控工具（ps、top、free…）"
arch=('x86_64')
url="https://gitlab.com/procps-ng/procps"
license=('GPL-3.0-or-later' 'LGPL-2.1-or-later')
options=(!strip !debug !lto)
# 依賴附錄 RUN=Glibc
depends=('glibc')
source=(${pkgname}-${pkgver}.tar.xz)
md5sums=('d47bdda51c4bd595a1ab21b8e538bcb3')

build() {
    cd ${pkgname}-${pkgver}
    # 書 8.80 pre 1–2（--enable-watch8bit 為現行書新增；舊模板的
    #   --exec-prefix= 與 libprocps.so 搬去 /lib 是 2017 習慣，規則 13 剔除）
    ./configure --prefix=/usr                           \
                --docdir=/usr/share/doc/procps-ng-4.0.7 \
                --disable-static                        \
                --disable-kill                          \
                --enable-watch8bit
    make
}

check() {
    cd ${pkgname}-${pkgver} && make check
}

package() {
    cd ${pkgname}-${pkgver}
    # 書 8.80 pre 4
    make DESTDIR="${pkgdir}" install
}
