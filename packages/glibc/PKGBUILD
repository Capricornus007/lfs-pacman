# MLFS 8.5 Glibc-2.44 —— §8.5（含 tzdata 2026e、34 locale、multilib lib32）；轉換規則見手冊 §7.4
pkgname=glibc
pkgver=2.44
pkgrel=1
pkgdesc="GNU C 庫（MLFS multilib：lib + lib32；第 8 章首包）"
arch=('x86_64')
url="https://www.gnu.org/software/libc/"
license=('GPL' 'LGPL' 'BSD' 'MIT')
options=(!strip !debug !lto)
# 規則 §7.4-1：depends 只寫帳本中存在的包名——glibc 是第 8 章首包，前面只有 bootstrap BLFS，
# 而它不依賴那些，故為空。書 8.5 的構建依賴（Bash/Binutils/Coreutils/Gawk/GCC/Grep/Make/
# Perl/Sed/Texinfo）是 chroot 手編底座，在 MLFS 帳本中不存在對應包，不寫。
depends=()
# 書 8.5.3/8.5.5 的 nsswitch.conf 與 ld.so.conf 進包；backup= 保證升級不覆蓋本機配置
backup=(etc/nsswitch.conf
        etc/ld.so.conf)
install=glibc.install
source=(${pkgname}-${pkgver}.tar.xz
        ${pkgname}-${pkgver}-upstream_fixes-3.patch
        ${pkgname}-fhs-1.patch
        tzdata2026e.tar.gz)
md5sums=('7677da43ef759c68e005f5d4c37986a6'
         '9edd452f9f99d4f87d8470c7029d237c'
         '9a5997c3452909b1769918c759eff8a2'
         'e1bb044ee184daee12f3e83ca16def7f')
# tzdata 是散檔 tar（無頂層目錄），makepkg 自動解壓會散落 $srcdir，改為 noextract 手動解
noextract=(tzdata2026e.tar.gz)

prepare() {
    mkdir -p tzdata-src
    tar -xf "${srcdir}/tzdata2026e.tar.gz" -C tzdata-src
    # 兩棵構建樹：64 位用原樹（§8.5.1）；32 位用副本（§8.5.2）
    rm -rf build32; cp -a ${pkgname}-${pkgver} build32
    # ── LTO 相容性補丁（2026-11-09，用戶指示「不支持就讓它支持，打補丁也得支持」）──
    # glibc 的 scripts/gen-as-const.py → glibcextract.compute_c_consts() 用
    # `gcc -S` 把 asm("/* @@@name@@@X@@@value@@@%0@@@end@@@ */") 編成組語，
    # 再從組語註解裡 regex 抽常數值（全樹 61 個 .sym 檔都走這條路徑）。
    # 帶 -flto 時 `gcc -S` 輸出的是 LTO 位元碼（.gnu.lto_* 段 + .base64），
    # 不是組語，註解全消失 → 標頭檔是空的 → SHADOW_STACK_POINTER_OFFSET 等
    # 常數未定義 → longjmp.c 靜態斷言炸。
    # 本機實測：無 -flto 時 .s 有 1 個 @@@name@@@；有 -flto=auto 時 0 個。
    #
    # 修法：只在這一個「抽常數」的子呼叫裡剝掉 -flto，其餘編譯／連結
    # 照吃全域 LTO。glibc 本體真的吃到 LTO，不是把它排除在外。
    for tree in ${pkgname}-${pkgver} build32; do
        python3 - "$tree/scripts/glibcextract.py" <<'PY'
import re, sys, pathlib
p = pathlib.Path(sys.argv[1])
s = p.read_text()
old = "        cmd = ('%s -S -o %s -x c - < %s' % (cc, s_file_name, c_file_name))"
new = ("        # MLFS: -flto makes gcc -S emit LTO bytecode instead of assembly, so the\n"
       "        # @@@name@@@ comments vanish and constants cannot be extracted. Strip\n"
       "        # -flto only for this constant-extraction sub-call; the rest of the\n"
       "        # build keeps LTO.\n"
       "        cc_no_lto = re.sub(r'-flto(?:=auto|=1|=4)?', '', cc)\n"
       "        cmd = ('%s -S -o %s -x c - < %s' % (cc_no_lto, s_file_name, c_file_name))")
assert s.count(old) == 1, 'gen-as-const cmd line not found exactly once in ' + sys.argv[1]
p.write_text(s.replace(old, new))
print('patched', sys.argv[1])
PY
    done
    cd ${pkgname}-${pkgver}
    # 書 8.5.1 兩個補丁，順序照書
    patch -Np1 -i "../${pkgname}-fhs-1.patch"
    patch -Np1 -i "../${pkgname}-${pkgver}-upstream_fixes-3.patch"
    cd ../build32
    patch -Np1 -i "../${pkgname}-fhs-1.patch"
    patch -Np1 -i "../${pkgname}-${pkgver}-upstream_fixes-3.patch"
}

build() {
    # CI 容器 gcc 預設啟用 CET（定義 __CET__）；本配方 configure 未啟用 CET 時，
    # glibc 的 SHADOW_STACK_POINTER_OFFSET 宏未定義，longjmp.c 的靜態斷言會報
    # undeclared。關閉 CET（與下方 --disable-cet 一致）讓 __CET__ 不被定義。
    #
    # 2026-11-09 修正：原本寫 -mshstk=no，但 GCC 16.2.1 沒有這個選項
    # （實測 `gcc -mshstk=no` → "unrecognized command-line option"），害 glibc
    # 在 configure 第一個測試 `checking for suffix of object files` 就 cannot
    # compile。實測只有 -fcf-protection 會定義 __CET__（-mshstk 不會），
    # 所以單靠 -fcf-protection=none 就足以關掉 CET，-mshstk 不帶也無妨。
    export CFLAGS="${CFLAGS} -fcf-protection=none"
    export CXXFLAGS="${CXXFLAGS} -fcf-protection=none"
    #
    # 2026-11-09 第二個根因（run 42562203613 實證）：glibc 建置期間的 -flto 會讓
    # gen-as-const 抽不到常數。症狀：longjmp.c 報 `SHADOW_STACK_POINTER_OFFSET
    # undeclared`，但這不是 CET 問題——斷點在 glibc 的 gen-as-const.py。
    # 機制（本機實測）：它把 `asm("/* @@@name@@@X@@@value@@@%0@@@end@@@ */" : : "i"(...))`
    # 編成 C，跑 `gcc -S` 再從組語註解裡 regex 抽值。帶 -flto=auto 時 `gcc -S`
    # 輸出的是 LTO 位元碼（.gnu.lto_* 段 + .base64），不是組語，`@@@name@@@`
    # 註解全部消失 → jmp_buf-ssp.h 是空的 → 常數未定義 → 靜態斷言炸。
    # 實測：無 -flto 時 .s 有 1 個 @@@name@@@；有 -flto=auto 時 0 個。
    #
    # 修法（用戶指示：不支持就讓它支持，打補丁也得支持）：
    # 已在 prepare() 打補丁到 scripts/glibcextract.py，只在那一個抽常數的
    # 子呼叫裡剝掉 -flto，其餘編譯／連結照吃全域 LTO。
    # 所以這裡不再剝 -flto，glibc 本體真的吃到 LTO。
    # 64 位（書 8.5.1 configure 原文）：
    #   書的 rm -fv /usr/share/config.site 是清 chroot 宿主殘留，makepkg 構建樹天然乾淨，等價省略；
    #   書的兩階段安裝（dest install→拷 so→make install）是為「替換正在使用的 glibc」設計，
    #   makepkg 是純 DESTDIR 構建，收斂為 package() 一次 DESTDIR install；
    #   include-fixed 清理動的是系統 gcc 目錄（非包內容），放 .install scriptlet。
    cd ${pkgname}-${pkgver}
    rm -rf build; mkdir -pv build
    cd build
    ../configure --prefix=/usr                   \
                 --disable-werror                \
                 --disable-nscd                  \
                 --disable-cet                   \
                 libc_cv_slibdir=/usr/lib        \
                 --enable-stack-protector=strong \
                 --enable-kernel=5.10
    make
    cd ../../build32
    # 32 位（書 8.5.2 configure 原文）
    rm -rf build; mkdir -pv build
    cd build
    CC="gcc -m32" CXX="g++ -m32"             \
    ../configure                             \
          --prefix=/usr                      \
          --host=i686-pc-linux-gnu           \
          --build=$(../../${pkgname}-${pkgver}/scripts/config.guess) \
          --libdir=/usr/lib32                \
          --libexecdir=/usr/lib32            \
          --disable-werror                   \
          --disable-nscd                     \
          --disable-cet                      \
          libc_cv_slibdir=/usr/lib32         \
          --enable-stack-protector=strong    \
          --enable-kernel=5.10
    make
}

check() {
    # 書 8.5.1：make check（64 位；耗時，makepkg.conf BUILDENV check 開啟才跑）。
    # 書 8.5.1 的 grep "Timed out" $(find -name \*.out) 供人工核對逾時項。
    cd ${pkgname}-${pkgver}/build && make check
}

package() {
    # 64 位安裝（書 8.5.1）
    cd ${pkgname}-${pkgver}/build
    make DESTDIR="${pkgdir}" install
    # 書 8.5.1：sed '/RTLDLIST=/s@/usr@@g' -i /usr/bin/ldd → 對包內文件等價照抄
    sed '/RTLDLIST=/s@/usr@@g' -i "${pkgdir}/usr/bin/ldd"
    # 書 8.5.1：rm -f /usr/sbin/nscd（--disable-nscd 下本不應存在，保險照做）
    rm -fv "${pkgdir}/usr/sbin/nscd"
    # 書 8.5.3：nsswitch.conf 全文（進包，backup=）
    install -Dm644 /dev/stdin "${pkgdir}/etc/nsswitch.conf" <<'EOF'
# Begin /etc/nsswitch.conf

passwd: files
group: files
shadow: files

hosts: files dns
networks: files

protocols: files
services: files
ethers: files
rpc: files

# End /etc/nsswitch.conf
EOF
    # 書 8.5.5：ld.so.conf 全文＋include 行（書 8.5.5 兩段 heredoc 合併）
    install -Dm644 /dev/stdin "${pkgdir}/etc/ld.so.conf" <<'EOF'
# Begin /etc/ld.so.conf
/usr/local/lib
/opt/lib

# Add an include directory
include /etc/ld.so.conf.d/*.conf

EOF
    install -d "${pkgdir}/etc/ld.so.conf.d"
    # 32 位安裝（書 8.5.2）：make DESTDIR=$PWD/DESTDIR install → cp lib32 →
    #   install lib-names/stubs-32.h → echo /usr/lib32 > /etc/ld.so.conf.d/lib32.conf
    cd ../../build32/build
    make DESTDIR="${srcdir}/glibc-m32" install
    install -d "${pkgdir}/usr/lib32"
    cp -a "${srcdir}/glibc-m32/usr/lib32/"* "${pkgdir}/usr/lib32/"
    install -Dm644 "${srcdir}/glibc-m32/usr/include/gnu/lib-names-32.h" \
                   "${pkgdir}/usr/include/gnu/lib-names-32.h"
    install -Dm644 "${srcdir}/glibc-m32/usr/include/gnu/stubs-32.h" \
                   "${pkgdir}/usr/include/gnu/stubs-32.h"
    install -Dm644 /dev/stdin "${pkgdir}/etc/ld.so.conf.d/lib32.conf" <<'EOF'
/usr/lib32
EOF
    # tzdata（書 8.5.4）：zic 三輪（plain/posix/right）＋三個 .tab＋-p 基準，全部 DESTDIR 化。
    #   書的 tzselect（交互）與 ln -sf …/etc/localtime 是使用者配置，屬手冊 §8.2，不進包。
    cd "${srcdir}/tzdata-src"
    ZONEINFO="${pkgdir}/usr/share/zoneinfo"
    mkdir -pv "${ZONEINFO}"/{posix,right}
    for tz in etcetera southamerica northamerica europe africa antarctica  \
              asia australasia backward; do
        zic -L /dev/null   -d "${ZONEINFO}"       ${tz}
        zic -L /dev/null   -d "${ZONEINFO}/posix" ${tz}
        zic -L leapseconds -d "${ZONEINFO}/right" ${tz}
    done
    cp -v zone.tab zone1970.tab iso3166.tab "${ZONEINFO}"
    zic -d "${ZONEINFO}" -p America/New_York
    unset ZONEINFO tz
}
