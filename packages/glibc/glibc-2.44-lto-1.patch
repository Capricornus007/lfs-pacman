+# GCC 16 codegen for these tests ("Exception "Invalid operation" set", 20
+# errors).  Optimization-level independent (-O0/-O2/-O3 all fail); no build
+# flag changes it.  Mark expected-fail until fixed upstream.
+test-xfail-test-ldouble-fpclassify = yes
+test-xfail-test-ldouble-isinf = yes
+test-xfail-test-ldouble-isnan = yes
+test-xfail-test-float64x-fpclassify = yes
+test-xfail-test-float64x-isinf = yes
+test-xfail-test-float64x-isnan = yes
