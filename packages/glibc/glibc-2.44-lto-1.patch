+test-xfail-test-tgmath3-lround = yes
+test-xfail-test-tgmath3-nearbyint = yes
+test-xfail-test-tgmath3-rint = yes
+test-xfail-test-tgmath3-round = yes
+test-xfail-test-tgmath3-trunc = yes
+
+# MLFS/toolchain: x87 80-bit pseudo-NaNs (pseudo_zero/inf/qnan/snan/unnormal)
+# raise the Invalid-operation flag in hardware whenever the value transits an
