# MLFS 8.36 Psmisc-23.7 —— §8.36
pkgname=psmisc
pkgver=23.7
pkgrel=1
pkgdesc="procfs 相關工具（fuser、killall、pstree…）"
arch=('x86_64')
url="https://psmisc.sourceforge.io/"
license=('GPL-2.0-or-later')
options=(!strip !debug lto)
# 依賴附錄 RUN=Glibc and Ncurses
depends=('glibc' 'ncurses')
source=(${pkgname}-${pkgver}.tar.xz)
md5sums=('53eae841735189a896d614cba440eb10')

build() {
    cd ${pkgname}-${pkgver}
    # 書 8.36 pre 1–2
    ./configure --prefix=/usr
    make
}

check() {
    cd ${pkgname}-${pkgver} && make check
}

package() {
    cd ${pkgname}-${pkgver}
    # 書 8.36 pre 4；舊模板把 fuser/killall 搬到 /bin 是 2017 版習慣，現行書無此步，不沿用
    make DESTDIR="${pkgdir}" install
}
