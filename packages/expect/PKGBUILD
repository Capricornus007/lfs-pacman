# MLFS 8.18 Expect-5.45.4 —— §8.18；無舊模板自寫（含 gcc15 補丁）
pkgname=expect
pkgver=5.45.4
pkgrel=1
pkgdesc="自動化交互程序工具（Tcl 擴展）"
arch=('x86_64')
url="https://core.tcl-lang.org/expect/"
license=('custom:EXPECT')
options=(!strip !debug !lto)

# Arch makepkg.conf 的 CFLAGS 含 -Werror=format-security，且 GCC 16 預設把
# implicit-function-declaration / int-conversion 等警告升成錯誤；expect 5.45.4
# 是舊碼，必須在 configure 之前把「警告轉錯誤」降回警告（不是關警告）。
#
# 關鍵：絕對不要用 `make CFLAGS=...` 覆蓋 CFLAGS！TEA 的 configure
# （expect5.45.4/configure:10008）生成的是
#   CFLAGS = <flags> ${CFLAGS_DEFAULT} ${CFLAGS_WARNING} ${SHLIB_CFLAGS}
# 其中 ${SHLIB_CFLAGS} = -fPIC。在 make 命令列覆蓋 CFLAGS 會把 -fPIC 一起丟掉，
# 連結 libexpect*.so 時就會噴
#   relocation R_X86_64_PC32 ... can not be used when making a shared object;
#   recompile with -fPIC
# 所以旗標只從環境帶進 configure，make 本身不再覆寫 CFLAGS。
export CFLAGS="${CFLAGS/-Werror=format-security/} -fPIC -Wno-error -Wno-error=format-security"
export CXXFLAGS="${CXXFLAGS/-Werror=format-security/} -Wno-error"

# 依賴附錄 RUN=Glibc and Tcl
depends=('glibc' 'tcl')
source=(expect${pkgver}.tar.gz
        expect-${pkgver}-gcc15-1.patch)
md5sums=('00fce8de158422f5ccd2666512329bd2'
         '0ca4d6bb8d572fbcdb13cb36cd34833e')

prepare() {
    cd expect${pkgver}
    # 書 8.18.1：gcc15 補丁
    patch -Np1 -i "../expect-${pkgver}-gcc15-1.patch"
}

build() {
    cd expect${pkgver}
    # 書 8.18.1 configure 原文
    #   （書節首的 python3 pty 檢查是宿主環境自檢，非構建命令；makepkg 環境由
    #    fakeroot 提供 pty，且 python 不在帳本，不納入）
    ./configure --prefix=/usr           \
                --with-tcl=/usr/lib     \
                --enable-shared         \
                --disable-rpath         \
                --mandir=/usr/share/man \
                --with-tclinclude=/usr/include
    # 不覆蓋 CFLAGS：讓 configure 生成的 ${SHLIB_CFLAGS}(-fPIC) 留在編譯旗標裡。
    # 只覆蓋 CFLAGS_WARNING（TEA 的警告旗標變數，已由上面的環境 CFLAGS 帶入
    # -Wno-error），其餘照書 8.18.1 用 make 建出 .so。
    make CFLAGS_WARNING="-Wno-error"
}

check() {
    cd expect${pkgver} && make test
}

package() {
    cd expect${pkgver}
    make DESTDIR="${pkgdir}" install
    # 書 8.18.1：ln -svf expect5.45.4/libexpect5.45.4.so /usr/lib
    #   （libexpect 裝在 /usr/lib/expect5.45.4/ 下，頂層符號連結進包）
    ln -svf expect5.45.4/libexpect5.45.4.so "${pkgdir}/usr/lib"
}
