# MLFS 8.75 Vim-9.2.1225 —— §8.75（新配置檔 /etc/vimrc 進包）
pkgname=vim
pkgver=9.2.1225
pkgrel=1
pkgdesc="Vi Improved 文字編輯器"
arch=('x86_64')
url="https://www.vim.org/"
license=('custom:vim')
options=(!strip !debug lto)
# 依賴附錄 RUN=Acl, Attr, Glibc, Python, Ncurses, and Tcl
depends=('acl' 'attr' 'glibc' 'python' 'ncurses' 'tcl')
source=(${pkgname}-${pkgver}.tar.gz)
md5sums=('a3594aae508c628c50bf3c71af37813b')
backup=(etc/vimrc)

prepare() {
    cd ${pkgname}-${pkgver}
    # 書 8.75 pre 1
    echo '#define SYS_VIMRC_FILE "/etc/vimrc"' >> src/feature.h
}

build() {
    cd ${pkgname}-${pkgver}
    # 書 8.75 pre 2–3
    ./configure --prefix=/usr
    make
}

check() {
    cd ${pkgname}-${pkgver}
    # 書 pre 4 的 chown -R tester 省略（規則 12）；測試修補照書
    sed '/test_plugin_glvs/d' -i src/testdir/Make_all.mak
    TERM=xterm-256color LANG=en_US.UTF-8 make -j1 test
}

package() {
    cd ${pkgname}-${pkgver}
    # 書 8.75 pre 6
    make DESTDIR="${pkgdir}" install
    # 書 8.75 pre 7
    ln -sv vim "${pkgdir}/usr/bin/vi"
    for L in "${pkgdir}"/usr/share/man/{,*/}man1/vim.1; do
        [ -e "$L" ] || continue
        ln -sv vim.1 "$(dirname "$L")/vi.1"
    done
    # 書 8.75 pre 8
    install -d "${pkgdir}/usr/share/doc"
    ln -sv ../vim/vim92/doc "${pkgdir}/usr/share/doc/vim-9.2.1225"
    # 書 8.75 pre 9：/etc/vimrc 是新建立的配置檔 → 進包（規則 12／14）
    install -d "${pkgdir}/etc"
    cat > "${pkgdir}/etc/vimrc" << "EOF"
" Begin /etc/vimrc

" Ensure defaults are set before customizing settings, not after
source $VIMRUNTIME/defaults.vim
let skip_defaults_vim=1

set nocompatible
set backspace=2
set mouse=
syntax on
if (&term == "xterm") || (&term == "putty")
  set background=dark
endif

" End /etc/vimrc
EOF
    # 書 pre 10–11（`vim -c ':options'`、`set spelllang`／`set spell`）為互動式，
    # 屬操作者動作，見 §7.4 規則 12 清單。
}
