# MLFS 8.35 Sed-4.10 —— §8.35
pkgname=sed
pkgver=4.10
pkgrel=1
pkgdesc="GNU 串流編輯器"
arch=('x86_64')
url="https://www.gnu.org/software/sed/"
license=('GPL-3.0-or-later')
options=(!strip !debug lto)
# 依賴附錄 RUN=Acl, Attr, and Glibc
depends=('acl' 'attr' 'glibc')
source=(${pkgname}-${pkgver}.tar.xz)
md5sums=('c70dc5372db95c816442ffedf77a0d0f')

build() {
    cd ${pkgname}-${pkgver}
    # 書 8.35 pre 1–2
    ./configure --prefix=/usr
    make
    make html
}

check() {
    cd ${pkgname}-${pkgver}
    # 書 pre 3 的 chown/su tester 省略：makepkg 本就非 root（§7.4 規則 12）
    make check
}

package() {
    cd ${pkgname}-${pkgver}
    # 書 8.35 pre 4
    make DESTDIR="${pkgdir}" install
    install -vDm644 doc/sed.html -t "${pkgdir}/usr/share/doc/sed-4.10"
}
