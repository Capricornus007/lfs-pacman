# MLFS 8.49 Automake-1.19 —— §8.49
pkgname=automake
pkgver=1.19
pkgrel=1
pkgdesc="GNU 自動產生 Makefile.in 的工具"
arch=('x86_64')
url="https://www.gnu.org/software/automake/"
license=('GPL-2.0-or-later')
options=(!strip !debug !lto)
# 依賴附錄 RUN=Bash, Coreutils, Grep, M4, Sed, and Texinfo
depends=('bash' 'coreutils' 'grep' 'm4' 'sed' 'texinfo')
source=(${pkgname}-${pkgver}.tar.xz)
md5sums=('da9b5c852b94089c7b7b16071ce8803c')

build() {
    cd ${pkgname}-${pkgver}
    # 書 8.49 pre 1–2
    ./configure --prefix=/usr --docdir=/usr/share/doc/automake-1.19
    make
}

check() {
    cd ${pkgname}-${pkgver}
    # 書 8.49 pre 3
    make -j$(($(nproc)>4?$(nproc):4)) check
}

package() {
    cd ${pkgname}-${pkgver}
    # 書 8.49 pre 4
    make DESTDIR="${pkgdir}" install
}
