# MLFS 8.22 Binutils-2.47 —— §8.22；轉換規則見手冊 §7.4
pkgname=binutils
pkgver=2.47
pkgrel=1
pkgdesc="彙編/連結/二進位操作工具集（as、ld、ar 等）"
arch=('x86_64')
url="https://www.gnu.org/software/binutils/"
license=('GPL-3.0-or-later')
options=(!strip !debug lto)
# 依賴附錄 RUN=Glibc, Zlib, and Zstd（--with-system-zlib）
depends=('glibc' 'zlib' 'zstd')
source=(${pkgname}-${pkgver}.tar.xz)
md5sums=('d772acfbd55a81644e9fe7b8189cd2a5')

build() {
    cd ${pkgname}-${pkgver}
    # gprofng 走自己的子 configure，其最終連結（gprofng-archive）用裸 ld 且不帶
    # LTO plugin → "plugin needed to handle lto object" + "undefined reference to main"。
    #
    # 2026-11-09 修正：原本 sed 把 gprofng Makefile 的 -flto=auto 換成 -fno-lto，
    # 但兩個原因讓它完全無效：
    #   1) gprofng 的 Makefile 是 make 階段由子 configure 才生成，configure 後 sed 找不到；
    #   2) 就算改到，makepkg 的 LTOFLAGS="-flto=auto" 會在命令列尾端再追加一次，
    #      後者覆蓋前者（本機實測 -fno-lto ... -flto=auto → 產物仍是 LTO 物件）。
    #
    # 真正的修法：整包編 fat LTO objects（-ffat-lto-objects）。fat 物件同時含 LTO
    # 位元碼與真實機器碼，裸 ld 讀得到機器碼就能連結，而 gcc 驅動的連結仍走 LTO
    # 優化。本機實測：slim LTO 物件 + 裸 ld → plugin needed + undefined main；
    # fat LTO 物件 + 裸 ld → 連結成功且執行正常。LTO 效果不變，只有物件檔大一點。
    # 放在 build() 開頭 export，configure 與 make（含 gprofng 子 configure）全覆蓋。
    export CFLAGS="${CFLAGS} -ffat-lto-objects"
    export CXXFLAGS="${CXXFLAGS} -ffat-lto-objects"
    # 書 8.22.1：out-of-tree 構建
    rm -rf build; mkdir -pv build
    cd build
    ../configure --prefix=/usr       \
                 --sysconfdir=/etc   \
                 --enable-ld=default \
                 --enable-plugins    \
                 --enable-shared     \
                 --disable-werror    \
                 --enable-64-bit-bfd \
                 --enable-new-dtags  \
                 --with-system-zlib  \
                 --with-lib-path=/usr/lib \
                 --enable-default-hash-style=gnu
    make tooldir=/usr
}

check() {
    # 書 8.22.1：make -k check；grep '^FAIL:' 供人工核對（書點名者之外任何 FAIL 都要查）
    cd ${pkgname}-${pkgver}/build
    make -k check
    grep '^FAIL:' $(find -name '*.log') || true
}

package() {
    cd ${pkgname}-${pkgver}/build
    make tooldir=/usr DESTDIR="${pkgdir}" install
    # 書 8.22.1：六個靜態庫＋gprofng doc 不進包（rm 的 DESTDIR 等價）
    rm -rfv "${pkgdir}/usr/lib/lib{bfd,ctf,ctf-nobfd,gprofng,opcodes,sframe}.a" \
            "${pkgdir}/usr/share/doc/gprofng/"
}
