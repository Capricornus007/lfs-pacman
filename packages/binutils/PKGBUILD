# MLFS 8.22 Binutils-2.47 —— §8.22；轉換規則見手冊 §7.4
pkgname=binutils
pkgver=2.47
pkgrel=1
pkgdesc="彙編/連結/二進位操作工具集（as、ld、ar 等）"
arch=('x86_64')
url="https://www.gnu.org/software/binutils/"
license=('GPL-3.0-or-later')
options=(!strip !debug !lto)
# 依賴附錄 RUN=Glibc, Zlib, and Zstd（--with-system-zlib）
depends=('glibc' 'zlib' 'zstd')
source=(${pkgname}-${pkgver}.tar.xz)
md5sums=('d772acfbd55a81644e9fe7b8189cd2a5')

build() {
    cd ${pkgname}-${pkgver}
    # 書 8.22.1：out-of-tree 構建
    rm -rf build; mkdir -pv build
    cd build
    ../configure --prefix=/usr       \
                 --sysconfdir=/etc   \
                 --enable-ld=default \
                 --enable-plugins    \
                 --enable-shared     \
                 --disable-werror    \
                 --enable-64-bit-bfd \
                 --enable-new-dtags  \
                 --with-system-zlib  \
                 --with-lib-path=/usr/lib \
                 --enable-default-hash-style=gnu
    make tooldir=/usr
}

check() {
    # 書 8.22.1：make -k check；grep '^FAIL:' 供人工核對（書點名者之外任何 FAIL 都要查）
    cd ${pkgname}-${pkgver}/build
    make -k check
    grep '^FAIL:' $(find -name '*.log') || true
}

package() {
    cd ${pkgname}-${pkgver}/build
    make tooldir=/usr DESTDIR="${pkgdir}" install
    # 書 8.22.1：六個靜態庫＋gprofng doc 不進包（rm 的 DESTDIR 等價）
    rm -rfv "${pkgdir}/usr/lib/lib{bfd,ctf,ctf-nobfd,gprofng,opcodes,sframe}.a" \
            "${pkgdir}/usr/share/doc/gprofng/"
}
