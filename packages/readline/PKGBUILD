# MLFS 8.12 Readline-8.3 —— §8.12（multilib：lib + lib32）；轉換規則見手冊 §7.4
pkgname=readline
pkgver=8.3
pkgrel=1
pkgdesc="GNU readline 行編輯庫（MLFS multilib）"
arch=('x86_64')
url="https://tiswww.case.edu/php/chet/readline/rltop.html"
license=('GPL-3.0-or-later')
options=(!strip !debug lto)
# 依賴附錄 RUN=Glibc and Ncurses；ncurses（書 8.34）在帳本中晚於本包——
# cutover 首次入帳按手冊 §7.4 規則 9 用 --assume-installed ncurses 過渡
depends=('glibc' 'ncurses')
source=(${pkgname}-${pkgver}.tar.gz)
md5sums=('25a73bfb2a3ad7146c5e9d4408d9f6cd')

prepare() {
    cd ${pkgname}-${pkgver}
    # 書 8.12.1 三個 sed 照抄（構建樹內操作）
    sed -i '/MV.*old/d' Makefile.in
    sed -i '/{OLDSUFF}/c:' support/shlib-install
    sed -i 's/-Wl,-rpath,[^ ]*//' support/shobj-conf
    # 書 8.12.1：input.c 補丁（-i.orig 留備份）
    sed -e '270a\
     else\
       chars_avail = 1;'      \
    -e '288i\   result = -1;' \
    -i.orig input.c
    cd "$srcdir"
    rm -rf build32
    cp -a "${pkgname}-${pkgver}" build32
}

build() {
    cd ${pkgname}-${pkgver}
    # 書 8.12.1
    ./configure --prefix=/usr    \
                --disable-static \
                --with-curses    \
                --docdir=/usr/share/doc/readline-8.3
    make SHLIB_LIBS="-lncursesw"
    cd ../build32
    # 書 8.12.2
    CC="gcc -m32" ./configure         \
        --host=i686-pc-linux-gnu      \
        --prefix=/usr                 \
        --libdir=/usr/lib32           \
        --disable-static              \
        --with-curses
    make SHLIB_LIBS="-lncursesw"
}

package() {
    cd ${pkgname}-${pkgver}
    make SHLIB_LIBS="-lncursesw" DESTDIR="${pkgdir}" install
    # 書 8.12.1：裝 doc（ps/pdf/html/dvi）
    install -dm755 "${pkgdir}/usr/share/doc/readline-8.3"
    install -vm644 doc/*.{ps,pdf,html,dvi} "${pkgdir}/usr/share/doc/readline-8.3" 2>/dev/null || true
    # 書 8.12.2：make DESTDIR=$PWD/DESTDIR install → cp DESTDIR/usr/lib32/* /usr/lib32
    cd ../build32
    make SHLIB_LIBS="-lncursesw" DESTDIR="${pkgdir}" install
}
