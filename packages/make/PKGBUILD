# MLFS 8.71 Make-4.4.1 —— §8.71
pkgname=make
pkgver=4.4.1
pkgrel=1
pkgdesc="GNU make 建置工具"
arch=('x86_64')
url="https://www.gnu.org/software/make/"
license=('GPL-3.0-or-later')
options=(!strip !debug !lto)
# 依賴附錄 RUN=Glibc
depends=('glibc')
source=(${pkgname}-${pkgver}.tar.gz)
md5sums=('c8469a3713cbbe04d955d4ae4be23eeb')

build() {
    cd ${pkgname}-${pkgver}
    # 書 8.71 pre 1–2
    ./configure --prefix=/usr
    make
}

check() {
    cd ${pkgname}-${pkgver}
    # 書 pre 3 的 chown/su tester 省略（規則 12）
    make check
}

package() {
    cd ${pkgname}-${pkgver}
    # 書 8.71 pre 4
    make DESTDIR="${pkgdir}" install
}
