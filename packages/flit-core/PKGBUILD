# MLFS 8.56 Flit-Core-4.1.0 —— §8.56（pip wheel → pip install，非 autotools）
# 書用 `pip3 wheel … $PWD` + `pip3 install --no-index --find-links dist`；
# DESTDIR 化見 §7.4 規則 14：加 --root $pkgdir、--ignore-installed、--no-deps。
pkgname=flit-core
pkgver=4.1.0
pkgrel=1
pkgdesc="PEP 517 輕量打包後端（flit_core）"
arch=('x86_64')
url="https://flit.pypa.io/"
license=('BSD-3-Clause')
options=(!strip !debug !lto)
# 依賴附錄 RUN=Python；帳本名 python（規則 14）
depends=('python')
source=(flit_core-${pkgver}.tar.gz)
md5sums=('6aed048324976ab2178d4d57a7933763')

build() {
    cd flit_core-${pkgver}
    # 書 8.56 pre 1
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps "$PWD"
}

package() {
    cd flit_core-${pkgver}
    # 書 8.56 pre 2（DESTDIR 化）
    pip3 install --root "${pkgdir}" --ignore-installed \
        --no-index --find-links dist --no-deps flit_core
}
