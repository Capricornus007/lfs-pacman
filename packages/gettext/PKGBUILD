# MLFS 8.37 Gettext-1.0 —— §8.37
pkgname=gettext
pkgver=1.0
pkgrel=1
pkgdesc="GNU 國際化（i18n）工具與函式庫"
arch=('x86_64')
url="https://www.gnu.org/software/gettext/"
license=('GPL-3.0-or-later' 'LGPL-2.1-or-later')
options=(!strip !debug !lto)
# 依賴附錄 RUN=Acl, Bash, Gcc, and Glibc（gcc 書中拼為 GCC，帳本名為 gcc）
depends=('acl' 'bash' 'gcc' 'glibc')
source=(${pkgname}-${pkgver}.tar.xz)
md5sums=('dc8b2911535929cec1e263706b0a13a1')

build() {
    cd ${pkgname}-${pkgver}
    # 書 8.37 pre 1–2
    ./configure --prefix=/usr    \
                --disable-static \
                --docdir=/usr/share/doc/gettext-1.0
    make
}

check() {
    cd ${pkgname}-${pkgver} && make check
}

package() {
    cd ${pkgname}-${pkgver}
    # 書 8.37 pre 4
    make DESTDIR="${pkgdir}" install
    chmod -v 0755 "${pkgdir}/usr/lib/preloadable_libintl.so"
}
