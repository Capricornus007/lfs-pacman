# MLFS 8.70 Libpipeline-1.5.8 —— §8.70
pkgname=libpipeline
pkgver=1.5.8
pkgrel=1
pkgdesc="子行程管線操作 C 函式庫（man-db 用）"
arch=('x86_64')
url="https://libpipeline.nongnu.org/"
license=('GPL-3.0-or-later')
options=(!strip !debug lto)
# 依賴附錄 RUN=Glibc
depends=('glibc')
source=(${pkgname}-${pkgver}.tar.gz)
md5sums=('17ac6969b2015386bcb5d278a08a40b5')

build() {
    cd ${pkgname}-${pkgver}
    # 書 8.70 pre 1–2
    ./configure --prefix=/usr
    make
}

package() {
    cd ${pkgname}-${pkgver}
    # 書 8.70 pre 3
    make DESTDIR="${pkgdir}" install
}
