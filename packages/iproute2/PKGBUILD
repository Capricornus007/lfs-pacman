# MLFS 8.68 IPRoute2-7.3.0 —— §8.68（make 系，無 configure）
pkgname=iproute2
pkgver=7.3.0
pkgrel=1
pkgdesc="IP 路由與網路設定工具（ip、tc、ss…）"
arch=('x86_64')
url="https://wiki.linuxfoundation.org/networking/iproute2"
license=('GPL-2.0-or-later')
options=(!strip !debug lto)
# 依賴附錄 RUN=Bash, Coreutils, Glibc, Libcap, Libelf, and Zlib
depends=('bash' 'coreutils' 'glibc' 'libcap' 'libelf' 'zlib')
source=(${pkgname}-${pkgver}.tar.xz)
md5sums=('b51e7e3eaf2cee927417192045f3466d')

prepare() {
    cd ${pkgname}-${pkgver}
    # 書 8.68 pre 1
    sed -i /ARPD/d Makefile
    rm -fv man/man8/arpd.8
    # flex ≥ 2.6.4 將 yyunput 定義為單參數巨集，與 emp_ematch.l 內的舊原型衝突，刪除之
    sed -i '/yyunput/d' tc/emp_ematch.l
}

build() {
    cd ${pkgname}-${pkgver}
    # 書 8.68 pre 2
    make NETNS_RUN_DIR=/run/netns
}

package() {
    cd ${pkgname}-${pkgver}
    # 書 8.68 pre 3
    make SBINDIR=/usr/sbin DESTDIR="${pkgdir}" install
    # 書 8.68 pre 4
    install -vDm644 COPYING README* -t "${pkgdir}/usr/share/doc/iproute2-7.3.0"
}
