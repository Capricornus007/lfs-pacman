# MLFS 8.77 Jinja2-3.1.6 —— §8.77（pip wheel → pip install）
pkgname=jinja2
pkgver=3.1.6
pkgrel=1
pkgdesc="Python 樣板引擎（systemd/udev 與 GRUB 工具鏈用）"
arch=('x86_64')
url="https://palletsprojects.com/p/jinja/"
license=('BSD-3-Clause')
options=(!strip !debug !lto)
# 依賴附錄 RUN=MarkupSafe and Python
depends=('markupsafe' 'python')
source=(${pkgname}-${pkgver}.tar.gz)
md5sums=('66d4c25ff43d1deaf9637ccda523dec8')

build() {
    cd ${pkgname}-${pkgver}
    # 書 8.77 pre 1
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps "$PWD"
}

package() {
    cd ${pkgname}-${pkgver}
    # 書 8.77 pre 2（規則 14 的 DESTDIR 化；書寫 `Jinja2`，wheel 正規名為 jinja2）
    pip3 install --root "${pkgdir}" --ignore-installed \
        --no-index --find-links dist --no-deps jinja2
}
