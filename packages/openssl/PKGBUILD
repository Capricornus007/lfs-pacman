# MLFS 8.50 OpenSSL-4.1.0 —— §8.50（無舊模板自寫；./config 系，兩棵樹）
pkgname=openssl
pkgver=4.1.0
pkgrel=1
pkgdesc="TLS/SSL 與通用密碼學工具組"
arch=('x86_64')
url="https://www.openssl.org/"
license=('Apache-2.0')
options=(!strip !debug !lto)
# 依賴附錄 RUN=Glibc and Perl
depends=('glibc' 'perl')
makedepends=('zlib' 'perl')
source=(${pkgname}-${pkgver}.tar.gz)
md5sums=('3dd690cc5ed65605cf4d125c1176439c')

prepare() {
    cd ${pkgname}-${pkgver}
    # OpenSSL 4.1.0 上游條件不一致（znver3 才會踩到）：
    #   crypto/evp/encode.c:178/246 以 __AVX2__ && HAVE_AVX2_INTRINSICS 決定呼叫
    #   encode_base64_avx2()，但 enc_b64_avx2.h 的宣告被 __x86_64__ 條件包住。
    # 32 位樹原本沒有 __AVX2__ 所以沒事；-march=znver3 定義 __AVX2__ 後，
    # 32 位會隱式宣告 → error。把使用處補上與宣告相同的 64 位條件，
    # 64 位行為完全不變，也不必把 32 位降回 generic。
    sed -i 's/#if defined(__AVX2__) && defined(HAVE_AVX2_INTRINSICS)/#if defined(__AVX2__) \&\& defined(HAVE_AVX2_INTRINSICS) \&\& (defined(__x86_64) || defined(__x86_64__))/' crypto/evp/encode.c
    grep -q 'defined(__x86_64) || defined(__x86_64__)' crypto/evp/encode.c || { echo "自檢失敗：encode.c 未補 64 位條件"; return 1; }
    cd ..
    rm -rf build32; cp -a ${pkgname}-${pkgver} build32
}

build() {
    cd ${pkgname}-${pkgver}
    # 書 8.50 pre 1–2
    ./config --prefix=/usr         \
             --openssldir=/etc/ssl \
             --libdir=lib          \
             shared                \
             zlib-dynamic
    make

    cd ../build32
    # 書 8.50 pre 8–9（linux-x86 目標＋no-docs，只取 lib32）
    ./config --prefix=/usr         \
             --openssldir=/etc/ssl \
             --libdir=lib32        \
             shared                \
             zlib-dynamic          \
             no-docs               \
             linux-x86
    make
}

check() {
    cd ${pkgname}-${pkgver} && make test
}

package() {
    cd ${pkgname}-${pkgver}
    # 書 8.50 pre 4；OpenSSL Makefile 認 DESTDIR（書 pre 10 亦用）
    make INSTALL_LIBS= MANSUFFIX=ssl DESTDIR="${pkgdir}" install
    # 書 8.50 pre 5–6
    if [ -d "${pkgdir}/usr/share/doc/openssl" ]; then
        mv -v "${pkgdir}/usr/share/doc/openssl" \
              "${pkgdir}/usr/share/doc/openssl-4.1.0"
    fi
    install -d "${pkgdir}/usr/share/doc/openssl-4.1.0"
    cp -vfr doc/. "${pkgdir}/usr/share/doc/openssl-4.1.0/"

    cd ../build32
    # 書 8.50 pre 10
    rm -rf "${srcdir}/openssl-m32"
    make DESTDIR="${srcdir}/openssl-m32" install
    install -d "${pkgdir}/usr/lib32"
    cp -Rv "${srcdir}/openssl-m32/usr/lib32/." "${pkgdir}/usr/lib32/"
}
