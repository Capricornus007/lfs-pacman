# MLFS 8.74 pre 6：重建 /usr/share/info/dir 索引
# 書原文（pushd /usr/share/info; rm dir; for f in *; install-info $f dir）作用對象是
# 已安裝的系統，不是 $pkgdir，故只能在 pacman 安裝後執行（手冊 §7.4 規則 12）。
_texinfo_rebuild_dir() {
    if [ -d /usr/share/info ]; then
        (
            cd /usr/share/info || return 0
            rm -f dir
            for f in *; do
                [ -f "$f" ] || continue
                [ "$f" = "dir" ] && continue
                install-info "$f" dir 2>/dev/null || true
            done
        )
    fi
}

post_install() {
    _texinfo_rebuild_dir
}

post_upgrade() {
    _texinfo_rebuild_dir
}
