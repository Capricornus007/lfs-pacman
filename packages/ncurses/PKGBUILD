# MLFS 8.34 Ncurses-6.6 —— §8.34（三棵樹：主裝／ABI-5 相容庫／32 位）
# 書用 distclean 連改兩次 configure；改為三棵副本，符合 §7.4 規則 10 可重入。
pkgname=ncurses
pkgver=6.6
pkgrel=1
pkgdesc="System V Release 4.0 curses 終端函式庫"
arch=('x86_64')
url="https://invisible-island.net/ncurses/"
license=('MIT')
options=(!strip !debug !lto)
# 依賴附錄 RUN=Glibc
depends=('glibc')
source=(${pkgname}-${pkgver}.tar.gz)
md5sums=('dd45bf6854430af403452a7a6a40652c')

prepare() {
    rm -rf abi5 build32; cp -a ${pkgname}-${pkgver} abi5
    cp -a ${pkgname}-${pkgver} build32
}

build() {
    cd ${pkgname}-${pkgver}
    # 書 8.34 pre 1–2
    ./configure --prefix=/usr           \
                --mandir=/usr/share/man \
                --with-shared           \
                --without-debug         \
                --without-normal        \
                --with-cxx-shared       \
                --enable-pc-files       \
                --with-pkg-config-libdir=/usr/lib/pkgconfig
    make

    cd ../abi5
    # 書 8.34 pre 7：--with-abi-version=5 只產舊 ABI 相容 .so.5
    ./configure --prefix=/usr     \
                --with-shared     \
                --without-normal  \
                --with-cxx-shared \
                --without-debug   \
                --without-cxx-binding \
                --with-abi-version=5
    make sources libs

    cd ../build32
    # 書 8.34 pre 9–10
    CC="gcc -m32" CXX="g++ -m32"         \
    ./configure --prefix=/usr            \
                --host=i686-pc-linux-gnu \
                --libdir=/usr/lib32      \
                --mandir=/usr/share/man  \
                --with-shared            \
                --without-debug          \
                --without-normal         \
                --with-cxx-shared        \
                --enable-pc-files        \
                --with-pkg-config-libdir=/usr/lib32/pkgconfig
    make
}

check() {
    cd ${pkgname}-${pkgver} && make check
}

package() {
    cd ${pkgname}-${pkgver}
    # 書 8.34 pre 3：make DESTDIR=$PWD/dest install → 直接 DESTDIR 到 $pkgdir
    make DESTDIR="${pkgdir}" install
    sed -e 's/^#if.*XOPEN.*$/#if 1/' -i "${pkgdir}/usr/include/curses.h"
    # 書 8.34 pre 4–5
    for lib in ncurses form panel menu; do
        ln -sfv lib${lib}w.so "${pkgdir}/usr/lib/lib${lib}.so"
        ln -sfv ${lib}w.pc    "${pkgdir}/usr/lib/pkgconfig/${lib}.pc"
    done
    ln -sfv libncursesw.so "${pkgdir}/usr/lib/libcurses.so"
    # 書 8.34 pre 6
    install -d "${pkgdir}/usr/share/doc/ncurses-6.6"
    cp -v -R doc/. "${pkgdir}/usr/share/doc/ncurses-6.6/"
    # 書 8.34 pre 7 尾：ABI 5 相容庫
    cd ../abi5
    cp -av lib/lib*.so.5* "${pkgdir}/usr/lib/"

    # 書 8.34 pre 11：32 位進暫存樹後只取 lib32
    cd ../build32
    rm -rf "${srcdir}/ncurses-m32"
    make DESTDIR="${srcdir}/ncurses-m32" install
    D="${srcdir}/ncurses-m32"
    mkdir -p "$D/usr/lib32/pkgconfig"
    for lib in ncurses form panel menu; do
        rm -vf                  "$D/usr/lib32/lib${lib}.so"
        echo "INPUT(-l${lib}w)" > "$D/usr/lib32/lib${lib}.so"
        ln -svf ${lib}w.pc        "$D/usr/lib32/pkgconfig/$lib.pc"
    done
    rm -vf                     "$D/usr/lib32/libcursesw.so"
    echo "INPUT(-lncursesw)" > "$D/usr/lib32/libcursesw.so"
    ln -sfv libncurses.so      "$D/usr/lib32/libcurses.so"
    install -d "${pkgdir}/usr/lib32"
    cp -Rv "$D/usr/lib32/." "${pkgdir}/usr/lib32/"
}
