# MLFS 8.57 Packaging-26.3 —— §8.57（pip wheel → pip install）
pkgname=packaging
pkgver=26.3
pkgrel=1
pkgdesc="Python 打包工具的核心公用程式（版本/specifier 解析）"
arch=('x86_64')
url="https://packaging.pypa.io/"
license=('Apache-2.0' 'BSD-2-Clause')
options=(!strip !debug !lto)
# 依賴附錄 RUN=Python
depends=('python')
source=(${pkgname}-${pkgver}.tar.gz)
md5sums=('c6809ec56986682ceffe573b8778a1ce')

build() {
    cd ${pkgname}-${pkgver}
    # 書 8.57 pre 1
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps "$PWD"
}

package() {
    cd ${pkgname}-${pkgver}
    # 書 8.57 pre 2（規則 14 的 DESTDIR 化）
    pip3 install --root "${pkgdir}" --ignore-installed \
        --no-index --find-links dist --no-deps packaging
}
