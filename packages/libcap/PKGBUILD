# MLFS 8.29 Libcap-2.78 —— §8.29（make 系，無 configure；32 位用 prefix 重定向）
pkgname=libcap
pkgver=2.78
pkgrel=1
pkgdesc="POSIX 1003.1e capabilities"
arch=('x86_64')
url="https://sites.google.com/site/fullycapable/"
license=('GPL-2.0-only' 'BSD-3-Clause')
options=(!strip !debug lto)
# 依賴附錄 RUN=Glibc
depends=('glibc')
source=(${pkgname}-${pkgver}.tar.xz)
md5sums=('0ff11419aa4813c0a0f84fe67bf3b39e')

prepare() {
    cd ${pkgname}-${pkgver}
    # 書 8.29 pre 1
    sed -i '/install -m.*STA/d' libcap/Makefile
    cd ..
    cd "$srcdir"
    rm -rf build32
    cp -a "${pkgname}-${pkgver}" build32
}

build() {
    cd ${pkgname}-${pkgver}
    # 書 8.29 pre 2。PAM_CAP=no：Arch 容器有 64 位 pam，libcap 的
    # Make.Rules 會自動編 pam_cap.so 並 -lpam；MLFS 書本系統沒有 PAM，
    # 且 multilib 沒有 lib32-pam，32 位會直接連結失敗。書本流程本就不建它。
    make prefix=/usr lib=lib PAM_CAP=no

    cd ../build32
    # 書 8.29 pre 6
    make CC="gcc -m32 -march=znver3 -mtune=znver3" PAM_CAP=no
}

check() {
    cd ${pkgname}-${pkgver} && make test PAM_CAP=no
}

package() {
    cd ${pkgname}-${pkgver}
    # 書 8.29 pre 4：make prefix=/usr lib=lib install → DESTDIR 化
    # RAISE_SETFCAP=no：fakeroot 下不可對套件檔做 setcap（沿用舊模板的實證手法）
    make DESTDIR="${pkgdir}" RAISE_SETFCAP=no lib=lib prefix=/usr PAM_CAP=no install

    cd ../build32
    # 書 8.29 pre 7：prefix 指向暫存樹，只取 lib32
    rm -rf "${srcdir}/libcap-m32"
    make CC="gcc -m32 -march=znver3 -mtune=znver3" PAM_CAP=no lib=lib32 \
         prefix="${srcdir}/libcap-m32/usr" -C libcap install
    install -d "${pkgdir}/usr/lib32"
    cp -av "${srcdir}/libcap-m32/usr/lib32/." "${pkgdir}/usr/lib32/"
    # 書 8.29 pre 7：修 32 位 pkgconfig 的 libdir
    sed -e "s|^libdir=.*|libdir=/usr/lib32|" \
        -i "${pkgdir}/usr/lib32/pkgconfig/lib"{cap,psx}.pc
    chmod -v 755 "${pkgdir}/usr/lib32/libcap.so.2.78"
}
