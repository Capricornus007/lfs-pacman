# MLFS 8.15 Bc-7.0.3 —— §8.15；新版為 Gavin Howard bc（與舊模板 1.07.1 完全不同構建系統）
pkgname=bc
pkgver=7.0.3
pkgrel=1
pkgdesc="任意精度計算器語言（Gavin Howard bc）"
arch=('x86_64')
url="https://git.gavinhoward.com/gavin/bc"
license=('BSD-2-Clause')
options=(!strip !debug !lto)
# 依賴附錄 RUN=Glibc, Ncurses, and Readline；ncurses 前向依賴同 readline（規則 §7.4-9）
depends=('glibc' 'ncurses' 'readline')
source=(${pkgname}-${pkgver}.tar.xz)
md5sums=('ad4db5a0eb4fdbb3f6813be4b6b3da74')

build() {
    cd ${pkgname}-${pkgver}
    # 書 8.15 原文
    CC='gcc -std=c99' ./configure --prefix=/usr -G -O3 -r
    make
}

check() {
    cd ${pkgname}-${pkgver} && make test
}

package() {
    cd ${pkgname}-${pkgver}
    make DESTDIR="${pkgdir}" install
}
