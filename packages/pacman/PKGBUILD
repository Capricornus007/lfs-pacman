# pacman-7.1.0 —— 手冊 §7.2 的 bootstrap 終點（無離線 BLFS 書頁）
# 建置命令逐字取自手冊 §7.2 的「之後才建 pacman 本身」程式碼塊；
# §7.1 已核實 meson.build／meson_options.txt：crypto 是 combo 無 auto，
# gpgme 初始可 disabled（makepkg.conf 用 !sign，不需 GnuPG）。
# ⚠️ source 不含 .sig：§5.3 已由操作者在 live USB 用 gpg --verify 驗過，
#    放進 source=() 會讓 makepkg 強制要求 gpg，與 bootstrap 的 !sign 衝突（手冊 §7.1）。
pkgname=pacman
pkgver=7.1.0
pkgrel=1
pkgdesc="libalpm 為基礎的套件管理器（含 makepkg）"
arch=('x86_64')
url="https://gitlab.archlinux.org/pacman/pacman"
license=('GPL-2.0-or-later')
options=(!strip !debug !lto)
depends=('bash' 'bzip2' 'coreutils' 'curl' 'fakeroot' 'file' 'findutils'
         'gettext' 'glibc' 'grep' 'gzip' 'libarchive' 'ncurses' 'openssl'
         'sed' 'tar' 'xz' 'zlib')
makedepends=('meson' 'ninja' 'python' 'pkgconf')
install=pacman.install
source=(${pkgname}-${pkgver}.tar.xz)
sha256sums=('530e50d7edbb2a22581c6d6707d2113240276c1bec4ee39a99488e1243c32171')
backup=(etc/pacman.conf etc/makepkg.conf)

build() {
    cd ${pkgname}-${pkgver}
    # 手冊 §7.2 原文
    rm -rf build
    meson setup build \
      --prefix=/usr \
      --sysconfdir=/etc \
      --localstatedir=/var \
      --buildtype=release \
      -D crypto=openssl \
      -D gpgme=disabled \
      -D curl=enabled \
      -D i18n=true \
      -D doc=disabled
    meson compile -C build
}

check() {
    cd ${pkgname}-${pkgver} && meson test -C build
}

package() {
    cd ${pkgname}-${pkgver}
    # 書用 meson install -C build --no-rebuild；DESTDIR 前置（規則 10）
    DESTDIR="${pkgdir}" meson install -C build --no-rebuild
    # useradd alpm 是對系統帳號庫的動作 → pacman.install（規則 12/16）
}
