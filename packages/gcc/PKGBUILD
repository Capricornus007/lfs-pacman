# MLFS 8.33 GCC-16.2.0 —— §8.33（multilib m64,m32 由 configure 一次搞定，不需兩棵樹）
pkgname=gcc
pkgver=16.2.0
pkgrel=1
pkgdesc="GNU Compiler Collection（C/C++，multilib m64/m32）"
arch=('x86_64')
url="https://gcc.gnu.org"
license=('GPL-3.0-or-later' 'LGPL-2.1-or-later' 'FDL-1.3-or-later' 'custom')
options=(!strip !debug lto)

# Arch makepkg.conf 的 CFLAGS/CXXFLAGS 含 -Werror=format-security。
# GCC 16.2.0 的 libcpp/expr.cc 把 N_() 取得的 const char *message 直接當 format
# string 傳給 cpp_warning_with_line()（宣告有 ATTRIBUTE_CPP_PPDIAG(5,6)），
# 會被 -Wformat-security 判為 "format not a string literal and no format
# arguments" 而死；GCC master 至今仍是這個寫法。Arch 官方 gcc PKGBUILD
# （svntogit-packages/gcc/trunk/PKGBUILD:108-109）也是在 configure 前移除該旗標。
# 只拿掉「警告轉錯誤」，-Wformat 與其餘 hardening flags 全部保留。
export CFLAGS="${CFLAGS/-Werror=format-security/}"
export CXXFLAGS="${CXXFLAGS/-Werror=format-security/}"

# 依賴附錄 RUN=Bash, Binutils, Glibc, Mpc, and Python（bash/python 前向依賴，規則 9/11）
depends=('bash' 'binutils' 'glibc' 'mpc' 'python')
# 書附錄 BUILD 中已在本書前批入帳的套件
makedepends=('gmp' 'mpfr' 'mpc' 'isl' 'zlib' 'zstd')
source=(${pkgname}-${pkgver}.tar.xz)
md5sums=('19b777fb19ea4982731392481306f0d3')

prepare() {
    cd ${pkgname}-${pkgver}
    # 書 8.33 pre 1–2
    sed -e '/m64=/s/lib64/lib/' \
        -e '/m32=/s/m32=.*/m32=..\/lib32$(call if_multiarch,:i386-linux-gnu)/' \
        -i.orig gcc/config/i386/t-linux64
    sed '/STACK_REALIGN_DEFAULT/s/0/(!TARGET_64BIT \&\& TARGET_SSE)/' \
          -i gcc/config/i386/i386.h
    # 書 8.33 pre 3；§7.4 規則 10 可重入
    rm -rf build; mkdir -v build
}

build() {
    cd ${pkgname}-${pkgver}/build
    # ── LTO 姿勢（2026-11-09 修正）──
    # GCC 是自舉編譯器，LTO 要走官方支援的 --with-build-config=bootstrap-lto，
    # 不能靠 makepkg 把 -flto 灌進外層 CFLAGS。實測失敗現場：
    #   stage1 編 libgcc_s.so 時，外層 -flto=auto 把多個 TU 合併成單一 LTRANS 單元，
    #   而 libgcc 的 __gttf2 帶 .symver ...@@GCC_4.3.0 版本化宣告；合併後同時出現
    #   "multiple definition of __gttf2" 與 "invalid attempt to declare external
    #   version name as default in symbol `__gttf2@@GCC_4.3.0'"，libgcc_s.so 連結死。
    # 本機已重現：分開編譯正常，合併成單一 LTRANS 就炸。
    # 所以：外層剝掉所有 -flto*（含 LTOFLAGS），LTO 完全交給 bootstrap-lto。
    export CFLAGS="$(echo "$CFLAGS" | sed -E 's/-flto(=auto|=1|=4)?//g')"
    export CXXFLAGS="$(echo "$CXXFLAGS" | sed -E 's/-flto(=auto|=1|=4)?//g')"
    export LTOFLAGS=""
    # 書 8.33 pre 4–5
    ../configure --prefix=/usr                \
                 LD=ld                        \
                 --enable-languages=c,c++     \
                 --enable-default-pie         \
                 --enable-default-ssp         \
                 --enable-host-pie            \
                 --enable-multilib            \
                 --with-multilib-list=m64,m32 \
                 --with-build-config=bootstrap-lto \
                 --enable-lto                 \
                 --disable-fixincludes        \
                 --with-system-zlib
    make
}

check() {
    cd ${pkgname}-${pkgver}/build
    # 書 8.33 pre 6；pre 7 的 chown/su tester 省略（makepkg 非 root）
    ulimit -s -H unlimited
    make -k check
    ../contrib/test_summary -t
}

package() {
    cd ${pkgname}-${pkgver}/build
    # 書 8.33 pre 9
    make DESTDIR="${pkgdir}" install

    # 書 8.33 pre 10：chown root:root 是對真系統的動作，fakeroot 下檔案已歸 root，
    # 不放進 package()（同 §7.4 規則 12）。
    # 書 8.33 pre 11：ln -svr /usr/bin/cpp /usr/lib
    ln -svr "${pkgdir}/usr/bin/cpp" "${pkgdir}/usr/lib/"
    # 書 8.33 pre 12
    ln -sv gcc.1 "${pkgdir}/usr/share/man/man1/cc.1"
    # 書 8.33 pre 13：書用 $(gcc -print-prog-name=liblto_plugin.so) 指向「剛裝好的 gcc」；
    # DESTDIR 下該 gcc 尚未在 PATH，改從 $pkgdir 找出實際檔案再建相對連結。
    # 本 PKGBUILD 的 configure 未設 --libexecdir，gcc 預設把 liblto_plugin.so 裝到
    # $pkgdir/usr/libexec/gcc/<target>/<ver>/（而非 usr/lib/gcc），故兩處都要找；
    # 找不到就直接報錯（不再建空目標的斷鏈，否則 makepkg 仍會失敗且訊息更難懂）。
    plugin=$(find "${pkgdir}/usr/lib/gcc" "${pkgdir}/usr/libexec/gcc" \
                  "${pkgdir}/usr/lib64/gcc" -name liblto_plugin.so -print -quit 2>/dev/null)
    if [ -z "$plugin" ]; then
        echo "ERROR: liblto_plugin.so not found under $pkgdir/usr/{lib,libexec}/gcc" >&2
        return 1
    fi
    install -vdm755 "${pkgdir}/usr/lib/bfd-plugins"
    ln -svr "${plugin}" "${pkgdir}/usr/lib/bfd-plugins/"
    # 書 8.33 pre 27
    install -vdm755 "${pkgdir}/usr/share/gdb/auto-load/usr/lib"
    mv -v "${pkgdir}/usr/lib/"*gdb.py \
          "${pkgdir}/usr/share/gdb/auto-load/usr/lib" 2>/dev/null || true
    # 書 8.33 pre 14–26 是「裝好後對真系統的 toolchain sanity check」，
    # 由 §7.4 批次 3 的批末驗收點在新系統上執行，不放進 package()。
}
