# MLFS 8.39 Grep-3.12 —— §8.39
pkgname=grep
pkgver=3.12
pkgrel=1
pkgdesc="GNU 字串搜尋工具"
arch=('x86_64')
url="https://www.gnu.org/software/grep/"
license=('GPL-3.0-or-later')
options=(!strip !debug !lto)
# 依賴附錄 RUN=Glibc
depends=('glibc')
source=(${pkgname}-${pkgver}.tar.xz)
md5sums=('5d9301ed9d209c4a88c8d3a6fd08b9ac')

prepare() {
    cd ${pkgname}-${pkgver}
    # 書 8.39 pre 1
    sed -i "s/echo/#echo/" src/egrep.sh
}

build() {
    cd ${pkgname}-${pkgver}
    # 書 8.39 pre 2–3
    ./configure --prefix=/usr
    make
}

check() {
    cd ${pkgname}-${pkgver} && make check
}

package() {
    cd ${pkgname}-${pkgver}
    # 書 8.39 pre 5
    make DESTDIR="${pkgdir}" install
}
