# MLFS 8.25 MPC-1.4.1 —— §8.25；轉換規則見手冊 §7.4
pkgname=mpc
pkgver=1.4.1
pkgrel=1
pkgdesc="多精度複數運算庫"
arch=('x86_64')
url="https://www.multiprecision.org/mpc/"
license=('LGPL-3.0-or-later')
options=(!strip !debug !lto)
# 依賴附錄 RUN=Glibc, GMP, and MPFR
depends=('glibc' 'gmp' 'mpfr')
source=(${pkgname}-${pkgver}.tar.xz)
md5sums=('40c5fba305125279ea46041160e81daf')

build() {
    cd ${pkgname}-${pkgver}
    # 書 8.25 原文
    ./configure --prefix=/usr    \
                --disable-static \
                --docdir=/usr/share/doc/mpc-1.4.1
    make
    make html
}

check() {
    cd ${pkgname}-${pkgver} && make check
}

package() {
    cd ${pkgname}-${pkgver}
    make DESTDIR="${pkgdir}" install
    make DESTDIR="${pkgdir}" install-html
}
