# MLFS 8.26 ISL-0.28 —— §8.26；無舊模板自寫
pkgname=isl
pkgver=0.28
pkgrel=1
pkgdesc="整數集合庫（polyhedral 優化，GCC graphite 用）"
arch=('x86_64')
url="https://libisl.sourceforge.io/"
license=('MIT')
options=(!strip !debug lto)
# 依賴附錄 RUN=Glibc, GMP, Libelf, and Xz；libelf 批次 5 晚於本包——cutover 按 §7.4 規則 9 過渡
depends=('glibc' 'gmp' 'libelf' 'xz')
source=(${pkgname}-${pkgver}.tar.xz)
md5sums=('2b84af1d8d9ffab00a69470bfe097709')

build() {
    cd ${pkgname}-${pkgver}
    # 書 8.26 原文
    ./configure --prefix=/usr    \
                --disable-static \
                --docdir=/usr/share/doc/isl-0.28
    make
}

check() {
    cd ${pkgname}-${pkgver} && make check
}

package() {
    cd ${pkgname}-${pkgver}
    make DESTDIR="${pkgdir}" install
    # 書 8.26：四份 doc 文件
    install -d "${pkgdir}/usr/share/doc/isl-0.28"
    install -m644 doc/{CodingStyle,manual.pdf,SubmittingPatches,user.pod} \
                  "${pkgdir}/usr/share/doc/isl-0.28"
    # 書 8.26：gdb auto-load 檔移位（mv 的 DESTDIR 等價）
    install -d "${pkgdir}/usr/share/gdb/auto-load/usr/lib"
    mv -v "${pkgdir}/usr/lib/libisl"*gdb.py "${pkgdir}/usr/share/gdb/auto-load/usr/lib" 2>/dev/null || true
}
