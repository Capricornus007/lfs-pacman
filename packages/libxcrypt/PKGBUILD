# MLFS 8.30 Libxcrypt-4.5.2 —— §8.30（無舊模板自寫；三棵樹）
# 書的兩輪 64 位：obsolete-api=no 主裝 → obsolete-api=glibc 只取 compat ABI 的
# libcrypt.so.1*；第三棵是 32 位。書用 distclean 重來，這裡改為三棵副本（§7.4 規則 10）。
pkgname=libxcrypt
pkgver=4.5.2
pkgrel=1
pkgdesc="現代密碼雜湊函式庫（yescrypt/bcrypt，含 glibc libcrypt 相容 ABI）"
arch=('x86_64')
url="https://github.com/besser82/libxcrypt"
license=('LGPL-2.1-or-later')
options=(!strip !debug lto)
# 依賴附錄 RUN=Glibc
depends=('glibc')
source=(${pkgname}-${pkgver}.tar.xz)
md5sums=('25e888919ddcd153a07daa95224fa436')

prepare() {
    cd ${pkgname}-${pkgver}
    # 書 8.30 pre 1
    sed -i '/strchr/s/const//' lib/crypt-{sm3,gost}-yescrypt.c
    cd ..
    rm -rf compat m32
    cp -a ${pkgname}-${pkgver} compat
    cp -a ${pkgname}-${pkgver} m32
}

build() {
    cd ${pkgname}-${pkgver}
    # 書 8.30 pre 2–3（主輪）
    ./configure --prefix=/usr                \
                --enable-hashes=strong,glibc \
                --enable-obsolete-api=no     \
                --disable-static             \
                --disable-failure-tokens
    make

    cd ../compat
    # 書 8.30 pre 6 前半（compat ABI 輪）
    ./configure --prefix=/usr                \
                --enable-hashes=strong,glibc \
                --enable-obsolete-api=glibc  \
                --disable-static             \
                --disable-failure-tokens
    make

    cd ../m32
    # 書 8.30 pre 8–9
    CC="gcc -m32"                            \
    ./configure --prefix=/usr                \
                --host=i686-pc-linux-gnu     \
                --libdir=/usr/lib32          \
                --enable-hashes=strong,glibc \
                --enable-obsolete-api=glibc  \
                --disable-static             \
                --disable-failure-tokens
    make
}

check() {
    cd ${pkgname}-${pkgver} && make check
}

package() {
    cd ${pkgname}-${pkgver}
    # 書 8.30 pre 5
    make DESTDIR="${pkgdir}" install

    cd ../compat
    # 書 8.30 pre 6 後半：只覆蓋 compat ABI 的 .so.1，不重裝整棵樹
    cp -av --remove-destination .libs/libcrypt.so.1* "${pkgdir}/usr/lib/"

    cd ../m32
    # 書 8.30 pre 10
    install -d "${pkgdir}/usr/lib32"
    cp -av .libs/libcrypt.so* "${pkgdir}/usr/lib32/"
    make DESTDIR="${pkgdir}" install-pkgconfigDATA
    ln -svf libxcrypt.pc "${pkgdir}/usr/lib32/pkgconfig/libcrypt.pc"
}
