# MLFS 8.20 Ninja-1.13.2 —— §8.20；無舊模板自寫
pkgname=ninja
pkgver=1.13.2
pkgrel=1
pkgdesc="注重速度的小型構建系統"
arch=('x86_64')
url="https://ninja-build.org/"
license=('Apache-2.0')
options=(!strip !debug !lto)
# 依賴附錄 RUN=GCC and Glibc；gcc 批次 3 晚於本包——cutover 首次入帳
# 按手冊 §7.4 規則 9 用 --assume-installed gcc 過渡
depends=('gcc' 'glibc')
source=(${pkgname}-${pkgver}.tar.gz)
md5sums=('76c00637fde44909cd7d56f8d73f2042')

prepare() {
    cd ${pkgname}-${pkgver}
    # 書 8.20：NINJAJOBS 支援補丁（多行 sed 照抄）
    sed -i '/int Guess/a \
      int   j = 0;\
      char* jobs = getenv( "NINJAJOBS" );\
      if ( jobs != NULL ) j = atoi( jobs );\
      if ( j > 0 ) return j;\
    ' src/ninja.cc
}

build() {
    cd ${pkgname}-${pkgver}
    # 書 8.20：python3 configure.py --bootstrap --verbose（NINJAJOBS=4 由 MAKEFLAGS 語境提供）
    export NINJAJOBS=4
    python3 configure.py --bootstrap --verbose
}

# 書 8.20 無測試小節

package() {
    cd ${pkgname}-${pkgver}
    # 書 8.20：三個 install 照抄，DESTDIR 化
    install -vm755 ninja "${pkgdir}/usr/bin/"
    install -vDm644 misc/bash-completion "${pkgdir}/usr/share/bash-completion/completions/ninja"
    install -vDm644 misc/zsh-completion  "${pkgdir}/usr/share/zsh/site-functions/_ninja"
}
