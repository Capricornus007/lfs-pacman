# MLFS 8.11 File-5.48 —— §8.11（multilib：lib + lib32）；轉換規則見手冊 §7.4
pkgname=file
pkgver=5.48
pkgrel=1
pkgdesc="檔案類型識別（magic；MLFS multilib）"
arch=('x86_64')
url="https://www.darwinsys.com/file/"
license=('BSD-2-Clause')
options=(!strip !debug lto)
# 依賴附錄 Required at runtime：Glibc, Bzip2, Xz, and Zlib
depends=('glibc' 'bzip2' 'xz' 'zlib')
source=(${pkgname}-${pkgver}.tar.gz)
md5sums=('423686e97f731d8c24e9cd1a22b03dec')

prepare() {
    rm -rf build32; cp -a ${pkgname}-${pkgver} build32
}

build() {
    cd ${pkgname}-${pkgver}
    # 書 8.11.1
    ./configure --prefix=/usr
    make
    cd ../build32
    # 書 8.11.2：CC="gcc -m32" --host=i686-pc-linux-gnu --libdir=/usr/lib32
    CC="gcc -m32" ./configure \
        --prefix=/usr         \
        --libdir=/usr/lib32   \
        --host=i686-pc-linux-gnu
    make
}

check() {
    # 書 8.11.1：make check（64 位）
    cd ${pkgname}-${pkgver} && make check
}

package() {
    cd ${pkgname}-${pkgver}
    make DESTDIR="${pkgdir}" install
    # 書 8.11.2：make DESTDIR=$PWD/DESTDIR install → cp DESTDIR/usr/lib32/* /usr/lib32
    cd ../build32
    make DESTDIR="${pkgdir}" install
}
