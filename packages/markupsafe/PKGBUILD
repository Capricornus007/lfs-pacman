# MLFS 8.76 MarkupSafe-3.0.4 —— §8.76（pip wheel → pip install）
pkgname=markupsafe
pkgver=3.0.4
pkgrel=1
pkgdesc="HTML/XML 安全字串跳脫（Jinja2 依賴）"
arch=('x86_64')
url="https://palletsprojects.com/p/markupsafe/"
license=('BSD-3-Clause')
options=(!strip !debug !lto)
# 依賴附錄 RUN=Python
depends=('python')
source=(${pkgname}-${pkgver}.tar.gz)
md5sums=('7c70b0284d3733795287d8d67e7164e0')

build() {
    cd ${pkgname}-${pkgver}
    # 書 8.76 pre 1
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps "$PWD"
}

package() {
    cd ${pkgname}-${pkgver}
    # 書 8.76 pre 2（規則 14 的 DESTDIR 化；書寫 `Markupsafe`，wheel 正規名為 markupsafe）
    pip3 install --root "${pkgdir}" --ignore-installed \
        --no-index --find-links dist --no-deps markupsafe
}
