# udev-standalone —— 汇集 eudev 3.3.0 + 下游重寫、零 systemd 執行期相依的 udev
# 2026-11-20 翻案：舊 clean-room 單檔 udev 作廢；新版本源自 udev-standalone 原倉
# (GitHub Capricornus007/udev-standalone tag v3.3.0-mlfs1)，autotools 建置。
pkgname=udev-standalone
pkgver=3.3.0
pkgrel=1
pkgdesc="systemd-free udev device manager (eudev 3.3.0 base + downstream merge)"
arch=('x86_64')
url="https://github.com/Capricornus007/udev-standalone"
license=('GPL-2.0-or-later')
options=(!strip !debug lto)
provides=('udev' 'libudev' 'libudev.so=1-64' 'libudev.so=1-32')
conflicts=('udev')
replaces=('udev')
depends=('glibc' 'libkmod' 'util-linux-libs')
makedepends=('gcc' 'make' 'gperf' 'pkgconf' 'autoconf' 'automake' 'libtool')
install=udev-standalone.install
backup=('etc/udev/udev.conf' 'etc/udev/hwdb.d/README')
source=("udev-standalone-${pkgver}.tar.gz")
sha256sums=('01404f5397529287abb8741f4bbd6214e0b0a49682a126f4f81af41e37455618')

prepare() {
    # makepkg 用 bsdtar 解包：若 tarball 頂層與檔名同名會被剝掉，退回 srcdir 根
    if [ -d "${srcdir}/udev-standalone-${pkgver}" ]; then
        cd "${srcdir}/udev-standalone-${pkgver}"
    else
        cd "${srcdir}"
    fi
    autoreconf -f -i -s
}

build() {
    # makepkg 用 bsdtar 解包：若 tarball 頂層與檔名同名會被剝掉，退回 srcdir 根
    if [ -d "${srcdir}/udev-standalone-${pkgver}" ]; then
        cd "${srcdir}/udev-standalone-${pkgver}"
    else
        cd "${srcdir}"
    fi
    ./configure --prefix=/usr --sysconfdir=/etc --libdir=/usr/lib \
                --sbindir=/usr/bin --disable-systemd-hwdb
    make -j4
}

package() {
    # makepkg 用 bsdtar 解包：若 tarball 頂層與檔名同名會被剝掉，退回 srcdir 根
    if [ -d "${srcdir}/udev-standalone-${pkgver}" ]; then
        cd "${srcdir}/udev-standalone-${pkgver}"
    else
        cd "${srcdir}"
    fi
    make DESTDIR="$pkgdir" install

    # 32-bit libudev（multilib；/usr/lib32 存在時）
    if [ -d /usr/lib32 ]; then
        CC="gcc -m32" CXX="g++ -m32" ./configure --prefix=/usr \
            --sysconfdir=/etc --libdir=/usr/lib32 --disable-systemd-hwdb >/dev/null
        # 頂層 make（不能用 make -C src/libudev：shared/libudev_shared.la 依賴會斷）
        make -j4 >/dev/null
        install -dm755 "$pkgdir/usr/lib32/pkgconfig"
        install -m755 src/libudev/.libs/libudev.so.1.* "$pkgdir/usr/lib32/"
        ln -sf "$(basename "$pkgdir"/usr/lib32/libudev.so.1.*)" "$pkgdir/usr/lib32/libudev.so.1"
        ln -sf libudev.so.1 "$pkgdir/usr/lib32/libudev.so"
    fi

    # 零 systemd 殘留閘門：檔名與文字都不得出現（版權 forked-from 已在上游改寫）
    if find "$pkgdir" -iname '*systemd*' | grep -q .; then
        error "systemd-named file found in the package tree"; return 1
    fi
    if grep -ril 'systemd' "$pkgdir" 2>/dev/null | grep -q .; then
        error "systemd text found in the package tree"; return 1
    fi
}
