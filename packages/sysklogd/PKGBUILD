# MLFS 8.83 Sysklogd-2.8.0 —— §8.83（/etc/syslog.conf 新配置檔進包）
pkgname=sysklogd
pkgver=2.8.0
pkgrel=1
pkgdesc="系統日誌精靈（syslogd、klogd）"
arch=('x86_64')
url="https://github.com/troglobit/sysklogd"
license=('BSD-3-Clause')
options=(!strip !debug !lto)
# 依賴附錄 RUN=Glibc
depends=('glibc')
source=(${pkgname}-${pkgver}.tar.gz)
md5sums=('cd36ab0c0214a42fc13a0c2c17dec5b6')
backup=(etc/syslog.conf)

build() {
    cd ${pkgname}-${pkgver}
    # 書 8.83 pre 1–2
    ./configure --prefix=/usr      \
                --sysconfdir=/etc  \
                --runstatedir=/run \
                --without-logger   \
                --disable-static   \
                --docdir=/usr/share/doc/sysklogd-2.8.0
    make
}

package() {
    cd ${pkgname}-${pkgver}
    # 書 8.83 pre 3
    make DESTDIR="${pkgdir}" install
    # 書 8.83 pre 4：新建立的配置檔 → 進包並列 backup（規則 12／14）
    install -d "${pkgdir}/etc"
    cat > "${pkgdir}/etc/syslog.conf" << "EOF"
# Begin /etc/syslog.conf

auth,authpriv.* -/var/log/auth.log
*.*;auth,authpriv.none -/var/log/sys.log
daemon.* -/var/log/daemon.log
kern.* -/var/log/kern.log
mail.* -/var/log/mail.log
user.* -/var/log/user.log
*.emerg *

# Do not open any internet ports.
secure_mode 2

# End /etc/syslog.conf
EOF
}
