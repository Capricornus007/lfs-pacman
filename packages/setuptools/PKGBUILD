# MLFS 8.59 Setuptools-84.2.1 —— §8.59（pip wheel → pip install）
pkgname=setuptools
pkgver=84.2.1
pkgrel=1
pkgdesc="Python 套件建置與散佈工具"
arch=('x86_64')
url="https://setuptools.pypa.io/"
license=('MIT')
options=(!strip !debug !lto)
# 依賴附錄 RUN=Python
depends=('python')
source=(${pkgname}-${pkgver}.tar.gz)
md5sums=('251cbfc8f83414155e0e595cc4cffdd2')

build() {
    cd ${pkgname}-${pkgver}
    # 書 8.59 pre 1
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps "$PWD"
}

package() {
    cd ${pkgname}-${pkgver}
    # 書 8.59 pre 2（規則 14 的 DESTDIR 化）
    pip3 install --root "${pkgdir}" --ignore-installed \
        --no-index --find-links dist --no-deps setuptools
}
